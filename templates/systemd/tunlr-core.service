# 由 tunlr 生成，tunlr init 时重写；不要直接修改。
[Unit]
Description=mihomo proxy kernel (managed by tunlr)
Documentation=https://tunlr.app
# 晚于 nftables.service：它加载的配置以 flush ruleset 开头，先于 _prestart 清空，不会清掉刚加载的规则。
After=network-online.target nftables.service
Wants=network-online.target
StartLimitIntervalSec=120
StartLimitBurst=5
OnFailure=tunlr-rescue.service

[Service]
Type=simple
User={{.User}}
Group={{.User}}
# 以 root 运行（+），不受 User= 和沙箱限制；失败不阻止内核启动（-）。
# _prestart 加载透明代理的回包规则，并关闭过期仍未确认的 TUN；_poststop 在内核以任何方式退出后清理规则。
ExecStartPre=-+{{.Tool}} _prestart
ExecStart={{.Binary}} -d {{.CoreDir}}
# 内核启动时本机没有 IPv6 就不给 TUN 配 IPv6 地址，开机时 IPv6 地址常比内核晚到，之后的 IPv6 流量
# 便绕过 TUN。跳过这个检查：没有 IPv6 时 TUN 照样带 IPv6 地址，IPv6 默认路由指向它。
Environment=SKIP_SYSTEM_IPV6_CHECK=1
ExecStopPost=-+{{.Tool}} _poststop
Restart=on-failure
RestartSec=3
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths={{.BinDir}} {{.CoreDir}}
ProtectHome=yes
PrivateTmp=yes
LimitNOFILE=1048576

[Install]
WantedBy=multi-user.target
