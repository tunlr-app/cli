# 由 tunlr 生成：面板对局域网开放时，内核 API 的端口只接受私有地址来的连接（DESIGN.md 第 10 节）。
# 内核 API 不能限制来源；这张表防止在公网服务器上把面板交给整个互联网。
# 先建后删再建，整个文件在一个事务中替换旧表。
table inet {{.Table}}
delete table inet {{.Table}}
table inet {{.Table}} {
	chain input {
		type filter hook input priority filter - 1; policy accept;
		tcp dport {{.Port}} ip saddr != { {{.Loopback}}, {{.Private}} } drop
		tcp dport {{.Port}} ip6 saddr != { {{.Loopback6}}, {{.Private6}} } drop
	}
}
