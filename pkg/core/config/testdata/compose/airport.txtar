内置模板 + 机场完整配置（结构仿照真实订阅，节点信息为假值）+ 常见 mixin。
订阅中的端口、API、DNS 等系统设置被丢弃，只采用路由部分。

-- generated.yaml --
secret: generated
-- subscription.yaml --
# Example Airport
# Generated for clash-verge
# port of HTTP
port: 7890

# port of SOCKS5
socks-port: 7891

allow-lan: false
mode: rule
log-level: info

# A RESTful API for clash
external-controller: 127.0.0.1:9090
secret: ""

dns:
  enable: true
  listen: 0.0.0.0:23453
  enhanced-mode: fake-ip
  nameserver:
    - 114.114.114.114

proxies:
  - name: Fast-HK-1
    type: ss
    server: hk1.example.net
    port: 2377
    udp: true
    udp-over-tcp: true
    cipher: chacha20-ietf-poly1305
    password: "example-password"
    plugin: obfs
    plugin-opts:
      mode: tls
      host: cdn.example.com
  - name: Fast-US-1
    type: ss
    server: us1.example.net
    port: 2378
    udp: true
    cipher: chacha20-ietf-poly1305
    password: "example-password"
  - name: AnyTLS-JP-1
    type: anytls
    server: jp1.example.net
    port: 443
    password: "example-password"
    client-fingerprint: chrome
    sni: jp1.example.net
    alpn:
      - h2
      - http/1.1
    skip-cert-verify: false
    idle-session-check-interval: 30
    idle-session-timeout: 30
    min-idle-session: 0

proxy-groups:
  - name: Default Proxy
    type: "select"
    proxies:
      - Auto
      - Fast-HK-1
      - Fast-US-1
      - AnyTLS-JP-1
  - name: Auto
    type: "url-test"
    url: "http://www.gstatic.com/generate_204"
    interval: 180
    tolerance: 100
    proxies:
      - Fast-HK-1
      - Fast-US-1
      - AnyTLS-JP-1
  - name: US Fixed IP
    type: "fallback"
    url: "http://www.gstatic.com/generate_204"
    interval: 120
    proxies:
      - Fast-US-1

rules:
- DOMAIN-SUFFIX,cn,DIRECT
- DOMAIN-KEYWORD,google,Default Proxy
- DOMAIN-SUFFIX,example-bank.com,US Fixed IP
- DST-PORT,22,DIRECT
- GEOIP,CN,DIRECT
- GEOIP,PRIVATE,DIRECT
- MATCH,Default Proxy
-- mixin.d/50-custom.yaml --
# 自己的规则放在机场规则之前。
prepend-rules:
  - DOMAIN-SUFFIX,internal.example.org,DIRECT
  - IP-CIDR,10.0.0.0/8,DIRECT,no-resolve

log-level: warning

# 只替换 nameserver，dns 的其他字段保留模板的值。
dns:
  nameserver:
    - https://1.1.1.1/dns-query
-- want.yaml --
# 本文件由 tunlr 生成，直接修改会在下次 apply 时被覆盖。
# 自定义设置请写在 mixin 中（tunlr edit）。

# 代理端口只监听本机；允许局域网访问时必须设置认证。
mixed-port: 7890
allow-lan: false

# 内核运行参数。
mode: rule
log-level: warning
ipv6: true
unified-delay: true
tcp-concurrent: true
find-process-mode: "off"

# 面板通过 SSH 隧道访问，HTTP API 只监听本机，secret 由 tunlr 为每台服务器生成。
# tunlr 自己经工作目录中的 Unix socket 访问 API。设置了 github-mirror 时，
# 面板的下载地址由 tunlr 改为经镜像下载。
external-controller: 127.0.0.1:9090
external-controller-unix: api.sock
secret: generated
external-ui: ui
external-ui-name: zashboard
external-ui-url: https://github.com/Zephyruso/zashboard/releases/latest/download/dist.zip

# 保存面板选择的节点和 fake-ip 映射。
profile:
  store-selected: true
  store-fake-ip: true

# geo 数据由 tunlr 每天的定时更新让内核下载，再按官方 sha256 核对。
# 内核自己的定时更新下载后不做校验，因此关闭。
geo-auto-update: false

# geo 数据的下载地址。设置了 github-mirror 时由 tunlr 改为经镜像下载。
geox-url:
  geoip: https://github.com/MetaCubeX/meta-rules-dat/releases/download/latest/geoip.dat
  geosite: https://github.com/MetaCubeX/meta-rules-dat/releases/download/latest/geosite.dat
  mmdb: https://github.com/MetaCubeX/meta-rules-dat/releases/download/latest/geoip.metadb
  asn: https://github.com/MetaCubeX/meta-rules-dat/releases/download/latest/GeoLite2-ASN.mmdb

dns:
  enable: true
  listen: 127.0.0.1:1053
  ipv6: true
  enhanced-mode: fake-ip
  fake-ip-range: 198.18.0.1/16
  fake-ip-filter:
    - "*.lan"
    - "*.local"
  default-nameserver:
    - 223.5.5.5
    - 119.29.29.29
  nameserver:
    - https://1.1.1.1/dns-query

proxies:
  - name: Fast-HK-1
    type: ss
    server: hk1.example.net
    port: 2377
    udp: true
    udp-over-tcp: true
    cipher: chacha20-ietf-poly1305
    password: "example-password"
    plugin: obfs
    plugin-opts:
      mode: tls
      host: cdn.example.com
  - name: Fast-US-1
    type: ss
    server: us1.example.net
    port: 2378
    udp: true
    cipher: chacha20-ietf-poly1305
    password: "example-password"
  - name: AnyTLS-JP-1
    type: anytls
    server: jp1.example.net
    port: 443
    password: "example-password"
    client-fingerprint: chrome
    sni: jp1.example.net
    alpn:
      - h2
      - http/1.1
    skip-cert-verify: false
    idle-session-check-interval: 30
    idle-session-timeout: 30
    min-idle-session: 0

proxy-groups:
  - name: Default Proxy
    type: "select"
    proxies:
      - Auto
      - Fast-HK-1
      - Fast-US-1
      - AnyTLS-JP-1
  - name: Auto
    type: "url-test"
    url: "http://www.gstatic.com/generate_204"
    interval: 180
    tolerance: 100
    proxies:
      - Fast-HK-1
      - Fast-US-1
      - AnyTLS-JP-1
  - name: US Fixed IP
    type: "fallback"
    url: "http://www.gstatic.com/generate_204"
    interval: 120
    proxies:
      - Fast-US-1

rules:
  - DOMAIN-SUFFIX,internal.example.org,DIRECT
  - IP-CIDR,10.0.0.0/8,DIRECT,no-resolve
  - DOMAIN-SUFFIX,cn,DIRECT
  - DOMAIN-KEYWORD,google,Default Proxy
  - DOMAIN-SUFFIX,example-bank.com,US Fixed IP
  - DST-PORT,22,DIRECT
  - GEOIP,CN,DIRECT
  - GEOIP,PRIVATE,DIRECT
  - MATCH,Default Proxy
-- dropped --
port
socks-port
allow-lan
mode
log-level
external-controller
secret
dns
