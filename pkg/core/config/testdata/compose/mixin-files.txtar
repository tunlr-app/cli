多个 mixin 文件按顺序逐个应用，后面的文件优先：同一个键以后面的为准并记为覆盖，
后面文件前插的规则排在更前面，后面的文件可以修改前面文件加入的项。
用普通键整体替换订阅的列表时给出警告；最终配置中有风险的设置也给出警告
（无需认证的端口不在这里检查，见 CheckExposure）。

-- template.yaml --
mixed-port: 7890
allow-lan: false
external-controller: 127.0.0.1:9090
secret: ""
dns:
  nameserver:
    - 223.5.5.5
-- generated.yaml --
secret: generated
-- subscription.yaml --
proxies:
  - {name: a, type: ss, server: a.example.net, port: 1, cipher: aes-128-gcm, password: p}
proxy-groups:
  - {name: g, type: select, proxies: [a]}
rules:
  - MATCH,g
-- mixin.d/10-base.yaml --
dns:
  nameserver:
    - 1.1.1.1
allow-lan: true
prepend-rules:
  - DOMAIN-SUFFIX,ten.example,DIRECT
append-proxy-groups:
  - {name: mine, type: select, proxies: [DIRECT]}
-- mixin.d/20-override.yaml --
dns:
  nameserver:
    - 8.8.8.8
prepend-rules:
  - DOMAIN-SUFFIX,twenty.example,DIRECT
patch-proxy-groups:
  - name: mine
    append-proxies: [a]
proxies:
  - {name: b, type: ss, server: b.example.net, port: 2, cipher: aes-128-gcm, password: p}
external-controller: 0.0.0.0:9090
secret: ""
-- want.yaml --
mixed-port: 7890
allow-lan: true
external-controller: 0.0.0.0:9090
secret: ""

dns:
  nameserver:
    - 8.8.8.8

proxies:
  - {name: b, type: ss, server: b.example.net, port: 2, cipher: aes-128-gcm, password: p}

proxy-groups:
  - {name: g, type: select, proxies: [a]}
  - {name: mine, type: select, proxies: [DIRECT, a]}

rules:
  - DOMAIN-SUFFIX,twenty.example,DIRECT
  - DOMAIN-SUFFIX,ten.example,DIRECT
  - MATCH,g
-- warnings --
20-override.yaml:9: proxies replaces the subscription's proxies entirely; use prepend-proxies, append-proxies, patch-proxies or delete-proxies to keep them
external-controller listens on 0.0.0.0:9090, which other hosts can reach; keep it on 127.0.0.1 and use an SSH tunnel
-- overrides --
dns.nameserver: 20-override.yaml overrides 10-base.yaml
secret: 20-override.yaml overrides tunlr
