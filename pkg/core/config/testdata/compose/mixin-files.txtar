多个 mixin 文件按顺序逐个应用，后面的文件优先：同一个键以后面的为准并记为覆盖，
后面文件前插的规则排在更前面，后面的文件可以修改前面文件加入的项。
用普通键整体替换订阅的列表时给出警告。

-- template.yaml --
mixed-port: 7890
allow-lan: false
external-controller: 127.0.0.1:9090
secret: ""
dns:
  nameserver:
    - 223.5.5.5
-- subscription.yaml --
proxies:
  - {name: a, type: ss, server: a.example.net, port: 1, cipher: aes-128-gcm, password: p}
proxy-groups:
  - {name: g, type: select, proxies: [a]}
rules:
  - MATCH,g
-- mixin.d/10-base.yaml --
mihomo:
  dns:
    nameserver:
      - 1.1.1.1
  allow-lan: true
tunlr:
  rules:
    prepend:
      - DOMAIN-SUFFIX,ten.example,DIRECT
  proxy-groups:
    append:
      - {name: mine, type: select, proxies: [DIRECT]}
-- mixin.d/20-override.yaml --
mihomo:
  dns:
    nameserver:
      - 8.8.8.8
  proxies:
    - {name: b, type: ss, server: b.example.net, port: 2, cipher: aes-128-gcm, password: p}
tunlr:
  rules:
    prepend:
      - DOMAIN-SUFFIX,twenty.example,DIRECT
  proxy-groups:
    patch:
      - name: mine
        append-proxies: [a]
-- want.yaml --
mixed-port: 7890
allow-lan: true
external-controller: 127.0.0.1:9090
secret: ""

dns:
  nameserver:
    - 8.8.8.8

proxies:
  - {name: b, type: ss, server: b.example.net, port: 2, cipher: aes-128-gcm, password: p}

proxy-groups:
  - {name: g, type: select, proxies: [a]}
  - {name: mine, type: select, proxies: [DIRECT, a]}

rules:
  - DOMAIN-SUFFIX,twenty.example,DIRECT
  - DOMAIN-SUFFIX,ten.example,DIRECT
  - MATCH,g
-- warnings --
20-override.yaml:5: mihomo.proxies replaces the subscription's proxies entirely; use tunlr.proxies (prepend, append, patch, delete) to keep them
-- overrides --
dns.nameserver: 20-override.yaml overrides 10-base.yaml
