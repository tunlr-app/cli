提供默认值的受管 mixin（配置了 GitHub 镜像时让镜像直连的规则）以 mixin 语义应用在订阅之后、
用户的 mixin 之前：用户前插的规则排在它前面，用户也可以用 delete-rules 去掉它。

-- template.yaml --
mixed-port: 7890
-- subscription.yaml --
proxies:
  - {name: a, type: ss, server: a.example.net, port: 1, cipher: aes-128-gcm, password: p}
rules:
  - MATCH,a
-- default/tunlr:mirror --
tunlr:
  rules:
    prepend:
      - DOMAIN,gh-proxy.com,DIRECT
      - DOMAIN,mirror.example.net,DIRECT
-- mixin.d/10-test.yaml --
tunlr:
  rules:
    prepend:
      - DOMAIN-SUFFIX,corp.example.com,DIRECT
    delete:
      - DOMAIN,mirror.example.net,DIRECT
-- want.yaml --
mixed-port: 7890

proxies:
  - {name: a, type: ss, server: a.example.net, port: 1, cipher: aes-128-gcm, password: p}

rules:
  - DOMAIN-SUFFIX,corp.example.com,DIRECT
  - DOMAIN,gh-proxy.com,DIRECT
  - MATCH,a
