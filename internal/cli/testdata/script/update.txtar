# 还没有订阅：只有 geo 数据，按模板由内核每周更新；还没有 geo 文件，没有下次更新
exec tunlr update
stdout '^geo\s+weekly \(7d\)\s+never\s+-$'
stdout 'mihomo downloads the geo data by itself'
! stdout '^sub '
exec tunlr update --json
stdout '"task": "geo"'
stdout '"period": "7d"'

# 订阅各有自己的周期：非交互时默认每天，--update 指定；sub 和 update 都显示
cp airport.yaml provider/airport.yaml
exec tunlr sub add main $PROVIDER/airport.yaml
stdout 'fetched again daily'
exec tunlr sub add spare $PROVIDER/airport.yaml --update off
stdout 'not fetched again automatically'
exec tunlr sub
stdout '^\*\s+main\s+2\s+\S+ \S+\s+daily\s+'
stdout '^\s+spare\s+2\s+\S+ \S+\s+never\s+'
exec tunlr sub --json
stdout '"update": "off"'
exec tunlr update
stdout '^sub main \*\s+daily \(1d\)\s+\S+ \S+ ok\s+\S+ \S+$'
stdout '^sub spare\s+never \(off\)\s+\S+ \S+ ok\s+-$'
exec tunlr status
stdout '^Updates:\s+sub main daily, last ok '
stdout '^\s+sub spare never$'
stdout '^\s+geo weekly by mihomo, no files yet$'

# sub set --update 改订阅的周期，保存在订阅列表中；default 恢复默认值
exec tunlr sub set main --update 6h
stdout '^"main" is fetched again every 6 hours\.$'
grep '^    update: 6h$' root/etc/tunlr/subscriptions.yaml
exec tunlr sub set main --update default
! grep '^    update: 6h$' root/etc/tunlr/subscriptions.yaml
exec tunlr sub set spare --update 1d
exec tunlr sub set spare --update off
stdout 'no longer updated automatically'
exitcode 2 tunlr sub set main --update 2w
stderr 'invalid update period "2w"'
exitcode 2 tunlr sub set main
stderr 'sub set needs the name of a subscription and what to change'
exitcode 2 tunlr sub set --update 6h
stderr 'sub set needs the name of a subscription and what to change'
exitcode 2 tunlr sub set main --update 6h --by tunlr
stderr 'unknown flag: --by'
exitcode 1 tunlr sub set nope --update off
stderr 'subscription not found: nope'

# geo 数据的设置按订阅调整：订阅没有写的用 tunlr 内置的兜底值（tunlr:defaults）；
# sub set --geo-update、--geo-url 写进订阅的 geo mixin（mixin.d/<订阅>/20-geo.yaml），启用的订阅随即发布
install-mihomo
exec tunlr config apply --yes
exec tunlr update
stdout '^Geo data settings with "main" active \(tunlr sub set main --geo-update, --geo-url changes them\):$'
stdout '^  geo-update-interval\s+168\s+fallback \(tunlr:defaults\)$'
exec tunlr sub set main --geo-update 2d --geo-url geosite=https://cdn.example/geosite.dat --yes
stdout '^Wrote geo-auto-update, geo-update-interval, geox-url.geosite for "main" to .*20-geo\.yaml\.$'
stdout '^\+geo-update-interval: 48$'
grep '^geo-update-interval: 48$' root/var/lib/tunlr/core/config.yaml
grep '^  geo-update-interval: 48$' root/etc/tunlr/mixin.d/main/20-geo.yaml
grep '^    geosite: https://cdn.example/geosite.dat$' root/etc/tunlr/mixin.d/main/20-geo.yaml
exec tunlr update
stdout '^geo\s+every 2 days \(2d\)\s+never\s+-$'
stdout '^  geox-url.geosite\s+https://cdn.example/geosite.dat\s+mixin main/20-geo.yaml$'
stdout '^  geox-url.mmdb\s+https://github.com/\S+\s+fallback \(tunlr:defaults\)$'
exec tunlr config plan
stdout '^Geo data settings not from the fallbacks: geo-auto-update \(main/20-geo.yaml\), geo-update-interval \(main/20-geo.yaml\), geox-url.geosite \(main/20-geo.yaml\) \(see: tunlr update\)$'
exec tunlr status
stdout '^\s+geo every 2 days by mihomo, no files yet$'
! stdout 'not published|outside tunlr|cannot compose'

# 没有启用的订阅：只写文件，它启用时生效
exec tunlr sub set spare --geo-update 1d --yes
stdout '^"spare" is not the active subscription; the change applies when it is \(tunlr sub use spare\)\.$'
grep '^  geo-update-interval: 24$' root/etc/tunlr/mixin.d/spare/20-geo.yaml
grep '^geo-update-interval: 48$' root/var/lib/tunlr/core/config.yaml
exec tunlr sub set spare --geo-update default --yes
! exists root/etc/tunlr/mixin.d/spare/20-geo.yaml

# 订阅写了的键：订阅的 geo mixin 覆盖它；恢复默认后用订阅写的值
cp airport-geo.yaml provider/airport.yaml
exec tunlr update run sub
grep '^geo-update-interval: 48$' root/var/lib/tunlr/core/config.yaml
exec tunlr sub set main --geo-update default --geo-url geosite=default --yes
stdout '^Removed .*20-geo\.yaml: "main" uses what it sets, or else tunlr''s fallbacks\.$'
! exists root/etc/tunlr/mixin.d/main/20-geo.yaml
grep '^geo-update-interval: 12$' root/var/lib/tunlr/core/config.yaml
exec tunlr update
stdout '^  geo-update-interval\s+12\s+the subscription$'
stdout '^  geo-auto-update\s+true\s+fallback \(tunlr:defaults\)$'
exec tunlr config plan
stdout '^Geo data settings not from the fallbacks: geo-update-interval \(subscription\) \(see: tunlr update\)$'

# 订阅的 mixin 中排在 20-geo.yaml 之后的文件写了的键：拒绝修改，改了也不生效；共用的 mixin 不影响
cp geo.yaml root/etc/tunlr/mixin.d/main/50-geo.yaml
exitcode 2 tunlr sub set main --geo-update 3d --yes
stderr 'geo-update-interval is set by the mixin main/50-geo.yaml, which is applied after main/20-geo.yaml; change it there \(tunlr config edit main/50-geo\)'
rm root/etc/tunlr/mixin.d/main/50-geo.yaml
cp geo.yaml root/etc/tunlr/mixin.d/10-geo.yaml
exec tunlr sub set main --geo-update 3d --yes
grep '^geo-update-interval: 72$' root/var/lib/tunlr/core/config.yaml
exec tunlr sub set main --geo-update default --yes
rm root/etc/tunlr/mixin.d/10-geo.yaml

# 用法错误
exitcode 2 tunlr sub set --geo-update 3d --yes
stderr 'sub set needs the name of a subscription and what to change'
exitcode 2 tunlr sub set main --geo-update 3d
stderr 'sub set --geo-update, --geo-url needs confirmation; pass --yes'
exitcode 1 tunlr sub set nope --geo-update 3d --yes
stderr 'subscription not found: nope'
exitcode 2 tunlr sub set main --geo-url other=https://x/ --yes
stderr 'unknown geo file "other"'
exitcode 2 tunlr sub set main --geo-url geosite --yes
stderr '--geo-url takes <file>=<url>'
exitcode 2 tunlr sub set main --geo-update 2w --yes
stderr 'invalid update period "2w"'

cp airport.yaml provider/airport.yaml
exec tunlr update run sub
# status 报告漂移：mixin 改了还没发布
cp log.yaml root/etc/tunlr/mixin.d/10-log.yaml
exec tunlr status
stdout '^\s+changes not published in log-level \(tunlr config plan shows them\)$'
exec tunlr status --json
stdout '"state": "pending"'
stdout '"log-level"'
rm root/etc/tunlr/mixin.d/10-log.yaml
exec tunlr status
! stdout 'not published'

# 用法错误：--dry-run
exitcode 2 tunlr sub set main --update 1d --dry-run
stderr 'does not support --dry-run'
exitcode 2 tunlr sub set main --geo-update 1d --dry-run
stderr 'does not support --dry-run'
exitcode 2 tunlr update run bogus
stderr 'unknown update "bogus"'
exitcode 2 tunlr update run --dry-run
stderr 'does not support --dry-run'

# 刚抓取的订阅没有到期，内核也没有换过：_update 什么都不输出
exec tunlr _update
! stdout .

-- geo.yaml --
mihomo:
  geo-update-interval: 48
-- airport-geo.yaml --
proxies:
  - {name: a, type: ss, server: a.example.net, port: 1, cipher: aes-128-gcm, password: p}
  - {name: b, type: ss, server: b.example.net, port: 2, cipher: aes-128-gcm, password: p}
proxy-groups:
  - {name: g, type: select, proxies: [a, b]}
rules:
  - MATCH,g
geo-update-interval: 12
-- log.yaml --
mihomo:
  log-level: warning
-- airport.yaml --
proxies:
  - {name: a, type: ss, server: a.example.net, port: 1, cipher: aes-128-gcm, password: p}
  - {name: b, type: ss, server: b.example.net, port: 2, cipher: aes-128-gcm, password: p}
proxy-groups:
  - {name: g, type: select, proxies: [a, b]}
rules:
  - MATCH,g
