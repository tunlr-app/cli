# 没有设置文件：全是默认值
exec tunlr settings
stdout '^github-mirror +none \(direct\)$'
stdout '^user-agent +clash\.meta mihomo tunlr/.* \(default\)$'
! stdout '^geo-'
stdout 'tunlr settings edit changes it'
exec tunlr settings --json
stdout '"key": "github-mirror"'
stdout '"value": ""'
stdout '"default": true'

# 文件中设置的值
mkdir root/etc/tunlr
cp settings.yaml root/etc/tunlr/settings.yaml
exec tunlr settings
stdout '^github-mirror +https://axisnow\.gh-proxy\.org/$'
stdout '^user-agent +clash\.meta$'
exec tunlr settings --json
stdout '"value": "https://axisnow.gh-proxy.org/"'

# 文件有错：报告出来
cp bad.yaml root/etc/tunlr/settings.yaml
! exec tunlr settings
stderr 'field github_mirror not found'

# edit 需要终端
exitcode 2 tunlr settings edit
stderr 'settings edit needs a terminal; edit .*settings\.yaml directly, then run tunlr config apply'

-- settings.yaml --
github-mirror: https://axisnow.gh-proxy.org/
user-agent: clash.meta
-- bad.yaml --
github_mirror: https://axisnow.gh-proxy.org/
