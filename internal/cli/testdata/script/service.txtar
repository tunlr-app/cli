# 尚未 init 时，status 照常报告
exec tunlr status
stdout 'Service: +not installed \(run: tunlr init\)'
stdout 'mihomo: +not installed'
stdout 'Subscription: +none'

exec tunlr status --json
stdout '"installed": false'
stdout '"kernels": \[\]'

# 服务控制需要先 init
exitcode 1 tunlr core start
stderr 'the mihomo service is not installed; run: tunlr init'
exitcode 1 tunlr core stop --yes
stderr 'run: tunlr init'
exitcode 1 tunlr core restart --yes
stderr 'run: tunlr init'

# 参数用法错误：退出码 2
exitcode 2 tunlr init --sub nope
stderr '--sub must be <name>=<url>'
exitcode 2 tunlr init --json --yes --gateway auto
stdout 'cannot be combined with --json'
exitcode 2 tunlr init --json --yes --lan-panel
stdout 'cannot be combined with --json'
exitcode 2 tunlr core upgrade --rollback
stderr 'unknown flag: --rollback'
exitcode 2 tunlr core rollback --version v1.19.33
stderr 'unknown flag: --version'
exitcode 2 tunlr core upgrade --version 1.19
stderr 'invalid mihomo version "v1.19"'
exitcode 2 tunlr core upgrade --file mihomo-linux-amd64-v3-v1.19.33.gz --version v1.19.33 --yes
stderr '--file installs the version in the file.s name; it cannot be combined with --version'
exitcode 2 tunlr init --kernel-file mihomo-linux-amd64-v3-v1.19.33.gz --version v1.19.33 --yes
stderr '--kernel-file installs the version in the file.s name; it cannot be combined with --version'
exitcode 2 tunlr core logs --json
stdout 'logs does not support --json'
exitcode 2 tunlr upgrade --version 0.2
stderr 'invalid tunlr version "v0.2"'
exitcode 2 tunlr upgrade --dry-run
stderr 'upgrade does not support --dry-run'

# tunlr upgrade 在 Setup 组里，非交互时也要 --yes
exec tunlr --help
stdout '^\s+upgrade\s+Upgrade tunlr itself'
exitcode 2 tunlr upgrade
stderr 'upgrade needs confirmation; pass --yes'

# 非交互时停止、重启、升级内核、卸载必须带 --yes，且不支持 --dry-run（不能当作已确认）
exitcode 2 tunlr core stop
stderr 'stop needs confirmation; pass --yes'
exitcode 2 tunlr core restart
stderr 'restart needs confirmation; pass --yes'
exitcode 2 tunlr core stop --dry-run
stderr 'stop does not support --dry-run'
exitcode 2 tunlr core upgrade
stderr 'core upgrade needs confirmation; pass --yes'
exitcode 2 tunlr core rollback
stderr 'core rollback needs confirmation; pass --yes'
exitcode 2 tunlr core rollback --dry-run
stderr 'does not support --dry-run'
exitcode 2 tunlr uninstall
stderr 'uninstall needs confirmation; pass --yes'
exitcode 2 tunlr uninstall --dry-run
stderr 'does not support --dry-run'
