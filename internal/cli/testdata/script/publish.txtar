# 内核未安装：plan 可以预览但无法校验；apply 必须校验，因此拒绝
exec tunlr config plan
stdout 'No active subscription'
stdout 'Nothing has been published yet'
stdout 'Check \(mihomo -t\): not run, mihomo is not installed'
exitcode 1 tunlr config apply --yes
stdout 'Not applied'
! exists root/var/lib/tunlr/core/config.yaml

# 非交互模式下没有 --yes 时，在开始工作前报告用法错误
exitcode 2 tunlr config apply
stderr 'apply needs confirmation; pass --yes'
! stdout .

# 安装（模拟的）内核后发布第一版
install-mihomo
exec tunlr config plan
stdout 'Check \(mihomo -t\): passed'
exec tunlr config apply --dry-run
stdout 'Dry run: nothing applied'
! exists root/var/lib/tunlr/core/config.yaml
exec tunlr config apply --yes
stdout 'Published revision 1 to '
stdout 'mihomo is not running; it will use this configuration when it starts'
grep '^external-controller-unix: api\.sock$' root/var/lib/tunlr/core/config.yaml
grep '^secret: [A-Za-z0-9]{8}$' root/var/lib/tunlr/core/config.yaml
grep '"api_secret": "[A-Za-z0-9]{8}"' root/var/lib/tunlr/state.json
exec tunlr config plan
stdout 'No changes'
exec tunlr config apply --yes
stdout 'No changes'
! stdout 'Published'

# 添加订阅后，diff 显示新增的节点，订阅中的系统键被忽略
cp airport.yaml provider/airport.yaml
exec tunlr sub add main $PROVIDER/airport.yaml
exec tunlr config plan
stdout 'Subscription: main'
stdout 'Ignored from the subscription: port, external-controller'
stdout '^Proxies: 1 added \(a\)$'
stdout '^\+  - MATCH,g$'
! stdout '^\+external-controller: 0'
exec tunlr config plan --full
stdout '^mixed-port: 7890$'
exec tunlr config apply --yes --json
stdout '"applied": true'
stdout '"reloaded": false'
stdout '"revision": 2'
stdout '"subscription": "main"'

# mixin 让配置无法通过 mihomo -t：退出码 3，不发布
mkdir root/etc/tunlr/mixin.d
cp bad-mixin.yaml root/etc/tunlr/mixin.d/50-rules.yaml
exitcode 3 tunlr config plan
stdout 'Mixins \(in order\): 50-rules.yaml'
stdout 'Check \(mihomo -t\): FAILED'
stdout 'proxy \[NOPE\] not found'
exitcode 3 tunlr config apply --yes
stdout 'Not applied'
exitcode 3 tunlr config apply --yes --json
stdout '"status": "failed"'
stdout '"applied": false'
! stdout '"error"'

# mixin 本身有错：指出文件和行，退出码 3
cp broken-mixin.yaml root/etc/tunlr/mixin.d/50-rules.yaml
exitcode 3 tunlr config plan
stderr 'mixin 50-rules.yaml:5: tunlr.rules.append: value must be a list'
exitcode 3 tunlr config apply --yes --json
stdout '"code": 3'

# 多个 mixin 按文件名顺序应用：plan 列出覆盖和警告；其他扩展名的文件被忽略
cp patch-mixin.yaml root/etc/tunlr/mixin.d/50-rules.yaml
cp level-mixin.yaml root/etc/tunlr/mixin.d/10-level.yaml
cp level-mixin.yaml root/etc/tunlr/mixin.d/90-ignored.yml
exec tunlr config plan
stdout 'Mixins \(in order\): 10-level.yaml, 50-rules.yaml$'
stdout '  log-level: 50-rules.yaml overrides 10-level.yaml'
stdout '  50-rules.yaml:7: tunlr.proxy-groups.patch: no item named missing; nothing changed'
stdout '^\+log-level: error$'
stdout '^\+  - \{name: g, type: select, proxies: \[DIRECT, a\]\}$'
exec tunlr config plan --json
stdout '"mixins": \['
stdout '"path": "log-level"'
stdout '"line": 7'
# 数字前缀位数不同时，文件名逐字符排序的结果与数值顺序不同，plan 给出警告
cp level-mixin.yaml root/etc/tunlr/mixin.d/9-late.yaml
exec tunlr config plan
stdout 'Mixins \(in order\): 10-level.yaml, 50-rules.yaml, 9-late.yaml$'
stdout '  9-late.yaml: applied after 10-level.yaml because names sort character by character; to apply it before, rename it to 09-late.yaml'
rm root/etc/tunlr/mixin.d/50-rules.yaml root/etc/tunlr/mixin.d/10-level.yaml root/etc/tunlr/mixin.d/90-ignored.yml root/etc/tunlr/mixin.d/9-late.yaml

# plan 列出 tunlr 管理的 mixin，不显示 secret 的值；geo 设置都是兜底值时不列出来源
exec tunlr config plan
stdout '^Managed by tunlr: tunlr:core, tunlr:tun, tunlr:panel, tunlr:proxy, tunlr:ipv6 \(mixins cannot change their keys; see: tunlr config\)$'
stdout '^Defaults from tunlr: tunlr:defaults, tunlr:dns \(mixins can override them; see: tunlr config\)$'
! stdout 'Geo data settings not from'
! stdout 'geox-url'
! stdout 'Rewritten by'
# 订阅没有写 dns 和 sniffer：plan 和 tunlr config 都指出它们来自兜底值
stdout '^DNS settings: dns, sniffer from the fallbacks \(see: tunlr config\)$'
exec tunlr config plan --json
stdout '"dns_sources": \['
stdout '"key": "sniffer",\s*$'
exec tunlr config
stdout '^DNS settings: dns, sniffer from the fallbacks$'
stdout '^No mixin files in '
stdout '^  tunlr:tun \(tunlr tun on/off\): tun.enable, tun.auto-route, '
stdout '^  tunlr:panel \(tunlr panel lan on/off, tunlr panel reset-secret\): external-controller, secret$'
stdout '^Defaults from tunlr:dns \(a mixin can override these\):$'
stdout '^      listen: 127.0.0.1:1053$'
stdout '^Fallbacks from tunlr:defaults \(geo data where the subscription sets none, dns and sniffer unless a subscription''s own are chosen; per subscription: tunlr sub set <sub> --geo-update, --geo-url, --dns; a mixin can override these\):$'
stdout '^      geo-update-interval: 168$'
! stdout 'tunlr:mirror'
exec tunlr config --json
stdout '"name": "tunlr:core"'
! stdout '"content": "secret'
stdout '"from": "tunlr:defaults",\s*$'

# mixin 改了 dns、删除了 sniffer：plan 指出改过它们的文件
cp dns-mixin.yaml root/etc/tunlr/mixin.d/10-dns.yaml
exec tunlr config plan
stdout '^DNS settings: dns from the fallbacks, changed by 10-dns.yaml; sniffer removed by 10-dns.yaml \(see: tunlr config\)$'
rm root/etc/tunlr/mixin.d/10-dns.yaml

# mixin 动了 tunlr 管理的键：拒绝，指出行和改用的命令，退出码 3
cp managed-mixin.yaml root/etc/tunlr/mixin.d/20-mine.yaml
exitcode 3 tunlr config plan
stderr '^tunlr: mixin 20-mine.yaml:4: tun.enable is managed by tunlr:tun \(change it with: tunlr tun on/off\); remove it from the mixin$'
exitcode 3 tunlr config apply --yes
rm root/etc/tunlr/mixin.d/20-mine.yaml

# 配置了 GitHub 镜像：面板经镜像下载，镜像的域名不加直连规则（和其他流量一样按规则分流）；兜底的 geox-url
# 经 jsDelivr，不改写；mixin 或订阅写的 github.com 地址在合成的最后改为经镜像，plan 列出改写的键，
# tunlr config 给出默认值和改写
cp mirror-settings.yaml root/etc/tunlr/settings.yaml
cp github-geo.yaml root/etc/tunlr/mixin.d/30-geo.yaml
exec tunlr config plan
stdout '^Defaults from tunlr: tunlr:defaults, tunlr:dns, tunlr:mirror \(mixins can override them; see: tunlr config\)$'
stdout '^Rewritten by tunlr:mirror: geox-url.mmdb$'
stdout '^\+  mmdb: https://axisnow.gh-proxy.org/https://github.com/MetaCubeX/meta-rules-dat/releases/download/latest/geoip.metadb$'
stdout '^   geosite: https://fastly.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@release/geosite.dat$'
! stdout 'axisnow.gh-proxy.org,DIRECT'
exec tunlr config plan --json
stdout '"name": "tunlr:mirror"'
stdout '"path": "geox-url.mmdb",\s*$'
exec tunlr config
stdout '^Defaults from tunlr:mirror \(tunlr settings edit; a mixin can override these\):$'
stdout '^    external-ui-url: https://axisnow.gh-proxy.org/https://github.com/Zephyruso/zashboard/releases/latest/download/dist-cdn-fonts.zip$'
! stdout ',DIRECT'
stdout '^  # then, after the mixins, https://github.com/ addresses in geox-url go through the mirror$'
rm root/etc/tunlr/settings.yaml
rm root/etc/tunlr/mixin.d/30-geo.yaml

# edit 需要终端
exitcode 2 tunlr config edit 20-home
stderr 'config edit needs a terminal'

# tunlr config 列出历史，* 标出生效的修订
exec tunlr config
stdout '^History \(tunlr config rollback'
stdout '^\s+\*\s+2\s+\S+ \S+\s+apply\s+main$'
stdout '^\s+1\s+\S+ \S+\s+apply\s+-$'
exec tunlr config --json
stdout '"history": \['
stdout '"current": true'

# 回滚：不指定修订时回到上一个不同的版本，连续回滚在两个版本间切换
exec tunlr config rollback --yes
stdout 'Rolling back to revision 1'
stdout 'Published revision 3'
! grep 'MATCH,g' root/var/lib/tunlr/core/config.yaml
exec tunlr config rollback --yes
stdout 'Rolling back to revision 2'
grep 'MATCH,g' root/var/lib/tunlr/core/config.yaml
exec tunlr config rollback 1 --yes
stdout 'Published revision 5'
exec tunlr config
stdout '^\s+\*\s+5\s+\S+ \S+\s+rollback to 1\s+-$'
exitcode 2 tunlr config rollback 99 --yes
stderr 'revision not found: 99 \(the history: tunlr config\)'
exitcode 2 tunlr config rollback abc
stderr 'revision must be a positive number'

# 手工改过的生效配置：历史中提示，下次发布前先存档
cp edited.yaml root/var/lib/tunlr/core/config.yaml
exec tunlr config
stdout 'matches no revision'
exec tunlr config apply --yes
stdout '^-edited: true$'
stdout 'Published revision 7'
exec tunlr config
stdout '^\s+6\s+\S+ \S+\s+found on disk\s+-$'
exec tunlr config rollback 6 --yes --json
stdout '"rollback_to": 6'
# 回滚恢复修订的内容，受管 mixin 独占的键按当前状态重新写入
grep '^edited: true$' root/var/lib/tunlr/core/config.yaml
grep '^external-controller-unix: api\.sock$' root/var/lib/tunlr/core/config.yaml
grep '^  enable: false$' root/var/lib/tunlr/core/config.yaml

# 差异很长时按顶层键汇总，--full-diff 完整显示；--json 中的差异总是完整的
cp long-mixin.yaml root/etc/tunlr/mixin.d/50-long.yaml
exec tunlr config plan
stdout '^The diff has \d+ lines; changed lines by section \(show all with --full-diff\):$'
stdout '^  rules\s+\+\d+\s+-0$'
! stdout 'DOMAIN,d1\.example'
exec tunlr config plan --full-diff
stdout '^\+  - ''DOMAIN,d1\.example,DIRECT''$'
exec tunlr config plan --json
stdout '"key": "rules"'
stdout 'DOMAIN,d1\.example'

-- airport.yaml --
port: 7890
external-controller: 0.0.0.0:9090
proxies:
  - {name: a, type: ss, server: a.example.net, port: 1, cipher: aes-128-gcm, password: p}
proxy-groups:
  - {name: g, type: select, proxies: [a]}
rules:
  - MATCH,g
-- bad-mixin.yaml --
tunlr:
  rules:
    prepend:
      - MATCH,NOPE
-- broken-mixin.yaml --
mihomo:
  log-level: info
tunlr:
  rules:
    append: MATCH,DIRECT
-- patch-mixin.yaml --
mihomo:
  log-level: error
tunlr:
  proxy-groups:
    patch:
      - {name: g, prepend-proxies: [DIRECT]}
      - {name: missing, interval: 60}
-- managed-mixin.yaml --
mihomo:
  tun:
    stack: system
    enable: true
-- mirror-settings.yaml --
github-mirror: https://axisnow.gh-proxy.org/
-- github-geo.yaml --
mihomo:
  geox-url:
    mmdb: https://github.com/MetaCubeX/meta-rules-dat/releases/download/latest/geoip.metadb
-- dns-mixin.yaml --
mihomo:
  dns:
    nameserver: [https://9.9.9.9/dns-query]
  sniffer: null
-- level-mixin.yaml --
mihomo:
  log-level: warning
-- edited.yaml --
edited: true
-- long-mixin.yaml --
tunlr:
  rules:
    append: ['DOMAIN,d1.example,DIRECT', 'DOMAIN,d2.example,DIRECT', 'DOMAIN,d3.example,DIRECT', 'DOMAIN,d4.example,DIRECT', 'DOMAIN,d5.example,DIRECT', 'DOMAIN,d6.example,DIRECT', 'DOMAIN,d7.example,DIRECT', 'DOMAIN,d8.example,DIRECT', 'DOMAIN,d9.example,DIRECT', 'DOMAIN,d10.example,DIRECT', 'DOMAIN,d11.example,DIRECT', 'DOMAIN,d12.example,DIRECT', 'DOMAIN,d13.example,DIRECT', 'DOMAIN,d14.example,DIRECT', 'DOMAIN,d15.example,DIRECT', 'DOMAIN,d16.example,DIRECT', 'DOMAIN,d17.example,DIRECT', 'DOMAIN,d18.example,DIRECT', 'DOMAIN,d19.example,DIRECT', 'DOMAIN,d20.example,DIRECT', 'DOMAIN,d21.example,DIRECT', 'DOMAIN,d22.example,DIRECT', 'DOMAIN,d23.example,DIRECT', 'DOMAIN,d24.example,DIRECT', 'DOMAIN,d25.example,DIRECT', 'DOMAIN,d26.example,DIRECT', 'DOMAIN,d27.example,DIRECT', 'DOMAIN,d28.example,DIRECT', 'DOMAIN,d29.example,DIRECT', 'DOMAIN,d30.example,DIRECT', 'DOMAIN,d31.example,DIRECT', 'DOMAIN,d32.example,DIRECT', 'DOMAIN,d33.example,DIRECT', 'DOMAIN,d34.example,DIRECT', 'DOMAIN,d35.example,DIRECT', 'DOMAIN,d36.example,DIRECT', 'DOMAIN,d37.example,DIRECT', 'DOMAIN,d38.example,DIRECT', 'DOMAIN,d39.example,DIRECT', 'DOMAIN,d40.example,DIRECT', 'DOMAIN,d41.example,DIRECT', 'DOMAIN,d42.example,DIRECT', 'DOMAIN,d43.example,DIRECT', 'DOMAIN,d44.example,DIRECT', 'DOMAIN,d45.example,DIRECT', 'DOMAIN,d46.example,DIRECT', 'DOMAIN,d47.example,DIRECT', 'DOMAIN,d48.example,DIRECT', 'DOMAIN,d49.example,DIRECT', 'DOMAIN,d50.example,DIRECT', 'DOMAIN,d51.example,DIRECT', 'DOMAIN,d52.example,DIRECT', 'DOMAIN,d53.example,DIRECT', 'DOMAIN,d54.example,DIRECT', 'DOMAIN,d55.example,DIRECT', 'DOMAIN,d56.example,DIRECT', 'DOMAIN,d57.example,DIRECT', 'DOMAIN,d58.example,DIRECT', 'DOMAIN,d59.example,DIRECT', 'DOMAIN,d60.example,DIRECT', 'DOMAIN,d61.example,DIRECT', 'DOMAIN,d62.example,DIRECT', 'DOMAIN,d63.example,DIRECT', 'DOMAIN,d64.example,DIRECT', 'DOMAIN,d65.example,DIRECT', 'DOMAIN,d66.example,DIRECT', 'DOMAIN,d67.example,DIRECT', 'DOMAIN,d68.example,DIRECT', 'DOMAIN,d69.example,DIRECT', 'DOMAIN,d70.example,DIRECT', 'DOMAIN,d71.example,DIRECT', 'DOMAIN,d72.example,DIRECT', 'DOMAIN,d73.example,DIRECT', 'DOMAIN,d74.example,DIRECT', 'DOMAIN,d75.example,DIRECT', 'DOMAIN,d76.example,DIRECT', 'DOMAIN,d77.example,DIRECT', 'DOMAIN,d78.example,DIRECT', 'DOMAIN,d79.example,DIRECT', 'DOMAIN,d80.example,DIRECT', 'DOMAIN,d81.example,DIRECT', 'DOMAIN,d82.example,DIRECT', 'DOMAIN,d83.example,DIRECT', 'DOMAIN,d84.example,DIRECT', 'DOMAIN,d85.example,DIRECT', 'DOMAIN,d86.example,DIRECT', 'DOMAIN,d87.example,DIRECT', 'DOMAIN,d88.example,DIRECT', 'DOMAIN,d89.example,DIRECT', 'DOMAIN,d90.example,DIRECT', 'DOMAIN,d91.example,DIRECT', 'DOMAIN,d92.example,DIRECT', 'DOMAIN,d93.example,DIRECT', 'DOMAIN,d94.example,DIRECT', 'DOMAIN,d95.example,DIRECT', 'DOMAIN,d96.example,DIRECT', 'DOMAIN,d97.example,DIRECT', 'DOMAIN,d98.example,DIRECT', 'DOMAIN,d99.example,DIRECT', 'DOMAIN,d100.example,DIRECT', 'DOMAIN,d101.example,DIRECT', 'DOMAIN,d102.example,DIRECT', 'DOMAIN,d103.example,DIRECT', 'DOMAIN,d104.example,DIRECT', 'DOMAIN,d105.example,DIRECT', 'DOMAIN,d106.example,DIRECT', 'DOMAIN,d107.example,DIRECT', 'DOMAIN,d108.example,DIRECT', 'DOMAIN,d109.example,DIRECT', 'DOMAIN,d110.example,DIRECT', 'DOMAIN,d111.example,DIRECT', 'DOMAIN,d112.example,DIRECT', 'DOMAIN,d113.example,DIRECT', 'DOMAIN,d114.example,DIRECT', 'DOMAIN,d115.example,DIRECT', 'DOMAIN,d116.example,DIRECT', 'DOMAIN,d117.example,DIRECT', 'DOMAIN,d118.example,DIRECT', 'DOMAIN,d119.example,DIRECT', 'DOMAIN,d120.example,DIRECT', 'DOMAIN,d121.example,DIRECT', 'DOMAIN,d122.example,DIRECT', 'DOMAIN,d123.example,DIRECT', 'DOMAIN,d124.example,DIRECT', 'DOMAIN,d125.example,DIRECT', 'DOMAIN,d126.example,DIRECT', 'DOMAIN,d127.example,DIRECT', 'DOMAIN,d128.example,DIRECT', 'DOMAIN,d129.example,DIRECT', 'DOMAIN,d130.example,DIRECT', 'DOMAIN,d131.example,DIRECT', 'DOMAIN,d132.example,DIRECT', 'DOMAIN,d133.example,DIRECT', 'DOMAIN,d134.example,DIRECT', 'DOMAIN,d135.example,DIRECT', 'DOMAIN,d136.example,DIRECT', 'DOMAIN,d137.ex