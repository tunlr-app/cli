CT', 'DOMAIN,d271.example,DIRECT', 'DOMAIN,d272.example,DIRECT', 'DOMAIN,d273.example,DIRECT', 'DOMAIN,d274.example,DIRECT', 'DOMAIN,d275.example,DIRECT', 'DOMAIN,d276.example,DIRECT', 'DOMAIN,d277.example,DIRECT', 'DOMAIN,d278.example,DIRECT', 'DOMAIN,d279.example,DIRECT', 'DOMAIN,d280.example,DIRECT', 'DOMAIN,d281.example,DIRECT', 'DOMAIN,d282.example,DIRECT', 'DOMAIN,d283.example,DIRECT', 'DOMAIN,d284.example,DIRECT', 'DOMAIN,d285.example,DIRECT', 'DOMAIN,d286.example,DIRECT', 'DOMAIN,d287.example,DIRECT', 'DOMAIN,d288.example,DIRECT', 'DOMAIN,d289.example,DIRECT', 'DOMAIN,d290.example,DIRECT', 'DOMAIN,d291.example,DIRECT', 'DOMAIN,d292.example,DIRECT', 'DOMAIN,d293.example,DIRECT', 'DOMAIN,d294.example,DIRECT', 'DOMAIN,d295.example,DIRECT', 'DOMAIN,d296.example,DIRECT', 'DOMAIN,d297.example,DIRECT', 'DOMAIN,d298.example,DIRECT', 'DOMAIN,d299.example,DIRECT', 'DOMAIN,d300.example,DIRECT', 'DOMAIN,d301.example,DIRECT', 'DOMAIN,d302.example,DIRECT', 'DOMAIN,d303.example,DIRECT', 'DOMAIN,d304.example,DIRECT', 'DOMAIN,d305.example,DIRECT', 'DOMAIN,d306.example,DIRECT', 'DOMAIN,d307.example,DIRECT', 'DOMAIN,d308.example,DIRECT', 'DOMAIN,d309.example,DIRECT', 'DOMAIN,d310.example,DIRECT']
